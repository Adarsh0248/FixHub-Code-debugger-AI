# GitHub OAuth application
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Keep an old index after a replacement becomes active
INDEX_RETIRED_RETENTION=7d

# Worker LLM provider
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://router.huggingface.co/v1
OPENAI_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Local PostgreSQL container
POSTGRES_DB=bugbrother
POSTGRES_USER=bugbrother
POSTGRES_PASSWORD=bugbrother-local-only
POSTGRES_HOST_PORT=5433
